# Optional overrides for non-Windows/server deployments.
CRM_PORT=8765
# COMPANY_CRM_API_KEY=

# Automatic Gemini Product Information (server-side only).
# Generates one complete product-specific object: Specifications, Product Description, Key Features and Applications.
# Copy this file to .env and enter the real key only in .env.
# NEVER place the real key in public/app.js, public/index.html, browser storage, README, or Git.
GEMINI_API_KEY=YOUR_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_ENABLE_GOOGLE_SEARCH=true
GEMINI_TIMEOUT_MS=16000
GEMINI_MAX_RETRIES=0
GEMINI_THINKING_LEVEL=low
PRODUCT_GENERATION_FAST_MODE=true
LEAD_ANALYSIS_CONCURRENCY=4
# 0 keeps generated product information permanently so repeat enquiries reuse it.
PRODUCT_INTELLIGENCE_CACHE_DAYS=0

# Optional only for PRIVATE Google Drive/Sheet files. Public/shared links work without these.
# Create a Google OAuth Web client and register: http://127.0.0.1:8765/api/google/oauth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Default company price source. Public/shared sheets are read server-side without OAuth.
DEFAULT_PRICE_SHEET_URL=
GOOGLE_SHEET_TIMEOUT_MS=60000
PRICE_SHEET_REFRESH_MINUTES=60

# Exact online price research: IndiaMART first, then Gemini grounded web search.
# A price is used only when product/model identity clears the safety threshold.
ONLINE_PRICE_RESEARCH_ENABLED=true
ONLINE_PRICE_TIMEOUT_MS=7000
ONLINE_PRICE_MAX_VARIANTS=2
ONLINE_PRICE_CACHE_HOURS=72

# Product research fallback chain. IndiaMART is also used for public technical
# product information.
INDIAMART_RESEARCH_ENABLED=true
INDIAMART_RESEARCH_TIMEOUT_MS=7000
INDIAMART_RESEARCH_MAX_VARIANTS=2
PRODUCT_RESEARCH_HTTP_TIMEOUT_MS=8000
PRODUCT_RESEARCH_MAX_VARIANTS=7
ONLINE_PRICE_GEMINI_TIMEOUT_MS=9000
PRODUCT_RESEARCH_FAST_MODE=true

GEMINI_PRODUCT_MODEL=gemini-3.8-flash
GEMINI_PRODUCT_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_PRODUCT_ENABLE_GOOGLE_SEARCH=true
GEMINI_PRODUCT_TIMEOUT_MS=16000
GEMINI_PRODUCT_MAX_RETRIES=0
GEMINI_PRODUCT_THINKING_LEVEL=low

# GitHub production update channel (V2.11.0+)
CRM_UPDATE_REPO=Nunes-instruments/Nunes_AI_Crm
CRM_UPDATE_BRANCH=main
CRM_GITHUB_AUTO_UPDATE=true
CRM_GITHUB_UPDATE_CHECK_MINUTES=5
